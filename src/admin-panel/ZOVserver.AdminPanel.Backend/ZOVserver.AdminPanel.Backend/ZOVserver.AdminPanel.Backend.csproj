<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="dotnet-etcd" Version="7.2.0"/>
        <PackageReference Include="Grpc.AspNetCore" Version="2.76.0"/>
        <PackageReference Include="ZOVserver.Shared.Contracts" Version="1.0.0" />
        <PackageReference Include="ZOVserver.Shared.Contracts.Proto" Version="1.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9"/>
        <PackageReference Include="Microsoft.Orleans.Clustering.Consul" Version="9.2.1"/>
        <PackageReference Include="Microsoft.Orleans.Clustering.ZooKeeper" Version="9.2.1"/>
        <PackageReference Include="Microsoft.Orleans.Sdk" Version="9.2.1"/>
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="Protos\gifts_service.proto" GrpcServices="Server"/>
        <Protobuf Include="Protos\messages_service.proto" GrpcServices="Server"/>
        <Protobuf Include="Protos\shop_service.proto" GrpcServices="Server"/>
        <Protobuf Include="Protos\statistics_service.proto" GrpcServices="Server"/>
        <Protobuf Include="Protos\user_service.proto" GrpcServices="Server"/>
    </ItemGroup>
</Project>
