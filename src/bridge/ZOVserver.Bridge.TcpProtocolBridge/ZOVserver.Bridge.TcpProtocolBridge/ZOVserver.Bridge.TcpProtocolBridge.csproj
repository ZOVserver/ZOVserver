<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Grpc.AspNetCore" Version="2.76.0"/>
        <PackageReference Include="DotNetty.Buffers" Version="0.7.6"/>
        <PackageReference Include="DotNetty.Transport" Version="0.7.6"/>
        <PackageReference Include="Microsoft.Orleans.Sdk" Version="9.2.1"/>
        <PackageReference Include="NATS.Client.Core" Version="2.7.2"/>
        <PackageReference Include="NATS.Client.Serializers.Json" Version="2.7.2"/>
        <PackageReference Include="NLog" Version="6.1.0"/>
        <PackageReference Include="Microsoft.Orleans.Clustering.Consul" Version="9.2.1"/>
        <PackageReference Include="Microsoft.Orleans.Clustering.ZooKeeper" Version="9.2.1"/>
        <PackageReference Include="SauceControl.Blake2Fast" Version="2.0.0"/>
        <PackageReference Include="ZOVserver.Bridge.TcpHellomateGirl" Version="1.0.2"/>
        <PackageReference Include="ZOVserver.RasputinProtect" Version="1.0.0"/>
        <PackageReference Include="ZOVserver.Shared.Contracts.Proto" Version="1.0.0"/>
        <PackageReference Include="ZOVserver.Shared.Localization" Version="1.0.0"/>
        <PackageReference Include="ZOVserver.Shared.TitanRemnants" Version="1.0.0"/>
        <PackageReference Include="ZOVserver.Shared.Contracts" Version="1.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="NLog.config">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
