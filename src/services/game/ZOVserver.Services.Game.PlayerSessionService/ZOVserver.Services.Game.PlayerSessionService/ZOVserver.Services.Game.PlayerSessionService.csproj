<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <ServerGarbageCollection>true</ServerGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="NLog.config">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Grpc.AspNetCore" Version="2.76.0"/>
        <PackageReference Include="prometheus-net" Version="8.2.1"/>
        <PackageReference Include="ZOVserver.Shared.Abstractions" Version="1.0.0" />
        <PackageReference Include="ZOVserver.Shared.Contracts.Proto" Version="1.0.0"/>
        <PackageReference Include="ZOVserver.Shared.Localization" Version="1.0.0" />
        <PackageReference Include="ZOVserver.Shared.TitanRemnants" Version="1.0.0" />
        <PackageReference Include="ZOVserver.Shared.Contracts" Version="1.0.0" />
        <PackageReference Include="Microsoft.Orleans.Clustering.Consul" Version="9.2.1"/>
        <PackageReference Include="Microsoft.Orleans.Persistence.Redis" Version="9.2.1"/>
        <PackageReference Include="Microsoft.Orleans.Server" Version="9.2.1"/>
        <PackageReference Include="Microsoft.Orleans.Clustering.ZooKeeper" Version="9.2.1"/>
        <PackageReference Include="Orleans.Providers.MongoDB" Version="9.5.0"/>
    </ItemGroup>

</Project>
