<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <ServerGarbageCollection>true</ServerGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="NLog.config">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="LogicLooper" Version="1.6.0"/>
        <PackageReference Include="NATS.Client.Core" Version="2.7.2"/>
        <PackageReference Include="NATS.Client.Serializers.Json" Version="2.7.2"/>
        <PackageReference Include="Microsoft.Orleans.Clustering.ZooKeeper" Version="9.2.1"/>
        <PackageReference Include="Microsoft.Orleans.Clustering.Consul" Version="9.2.1"/>
        <PackageReference Include="Microsoft.Orleans.Server" Version="9.2.1"/>
        <PackageReference Include="ZLinq" Version="1.5.5"/>
        <PackageReference Include="ZOVserver.RasputinProtect" Version="1.0.0"/>
        <PackageReference Include="ZOVserver.Shared.Contracts.Proto" Version="1.0.0"/>
        <PackageReference Include="ZOVserver.Shared.Contracts" Version="1.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="LogicPathFinder.cs"/>
    </ItemGroup>

</Project>
